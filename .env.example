# HydroVerse Flood Simulator Environment Configuration
# Copy this file to .env.local to override default settings

# Application Server Port
VITE_PORT=5173

# Default Geographic Configuration (clonmel | dibrugarh)
VITE_DEFAULT_TOWN=clonmel

# Live River Gauge API Endpoints (Fallback to simulated telemetry when unavailable)
# Clonmel OPW Sensor 16011 (River Suir)
VITE_OPW_GAUGE_URL=https://waterlevel.ie/hydro-data/stations/16011/
# Dibrugarh CWC / WRD Assam Gauge (Brahmaputra)
VITE_WRD_ASSAM_GAUGE_URL=https://ffs.india-water.gov.in/

# Telemetry Cache TTL (seconds)
VITE_TELEMETRY_CACHE_TTL=300

# Simulation Precision & Stability
VITE_SWE_CFL_LIMIT=0.45
VITE_SWE_MANNING_N=0.028
